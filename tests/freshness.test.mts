import assert from "node:assert/strict";
import { test } from "node:test";
import { freshness } from "../src/lib/freshness.ts";
import { refreshProblem } from "../src/lib/congress.ts";

const now = new Date("2026-10-22T12:00:00Z");

test("freshness reports age and flags stale snapshots", () => {
  assert.deepEqual(freshness("2026-10-22T01:00:00Z", now, 3), { ageDays: 0, stale: false, label: "today" });
  assert.equal(freshness("2026-10-19T11:00:00Z", now, 3).stale, false);
  assert.equal(freshness("2026-10-18T11:00:00Z", now, 3).stale, true);
  assert.equal(freshness("not a date", now, 3).stale, true);
  assert.equal(freshness("2027-01-01T00:00:00Z", now, 3).ageDays, 0);
});

test("a refresh may not shrink, duplicate or empty the Congress snapshot", () => {
  const bill = (id: string) => ({ id }) as never;
  const prev = Array.from({ length: 60 }, (_, i) => bill(`119-hr-${i + 1}`));
  assert.equal(refreshProblem(prev, prev), null);
  assert.match(refreshProblem(prev, [])!, /no bills/);
  assert.match(refreshProblem(prev, prev.slice(0, 20))!, /fewer than half/);
  assert.match(refreshProblem(prev, [...prev.slice(0, 40), bill("119-hr-1")])!, /duplicate/);
  assert.equal(refreshProblem(undefined, prev), null);
});

test("the committed health report agrees with the data it summarizes", async () => {
  const { readFileSync } = await import("node:fs");
  const health = JSON.parse(readFileSync("data/research-health.json", "utf8"));
  const e = JSON.parse(readFileSync("data/elections/colorado-2026.json", "utf8"));
  const congress = JSON.parse(readFileSync("data/congress/bills.json", "utf8"));
  const fr = JSON.parse(readFileSync("data/federal-register.json", "utf8"));
  const counts: Record<string, number> = { draft: 0, "source-checked": 0, reviewed: 0, "needs-re-review": 0 };
  for (const m of e.measures) counts[m.draft.review.status]++;
  assert.deepEqual(health.sources["colorado-2026-election"].reviewQueue, counts, "run `npm run health` and commit the result");
  assert.equal(health.sources["colorado-2026-election"].dataVerifiedAt, e.dataVerifiedAt);
  assert.ok(congress.bills.length > 0 && health.sources["govinfo-billstatus"].billCount > 0);
  // Federal Register and Congress timestamps are regenerated by the scheduled job after it refreshes data, so only
  // the hand-edited election data is compared strictly with the committed report here.
  assert.ok(fr.retrievedAt);
});
