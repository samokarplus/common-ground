{
  "name": "common-ground-public",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3020",
    "build": "tsc --noEmit && node scripts/clean-build.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3021",
