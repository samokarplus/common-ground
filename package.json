    "lint": "eslint src tests",
    "refresh:fr": "node --experimental-strip-types scripts/refresh-federal-register.mts",
    "health": "node --experimental-strip-types scripts/research-health.mts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/libre-caslon-display": "^5.2.8",
